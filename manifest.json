{
    "manifest_version": 3,
    "name": "Repo Size",
    "version": "1.0.1",
    "description": "Display the repo size.",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://github.com/*",
        "https://api.github.com/*"
    ],
    "action": {
        "default_popup": "index.html"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
